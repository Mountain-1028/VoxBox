{
  "name": "voxbox",
  "version": "1.0.0",
  "description": "VoxBox - Text-to-Speech desktop app with TikTok & Edge voices",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "author": "Danny",
  "license": "MIT",
  "dependencies": {
    "msedge-tts": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.voxbox.app",
    "productName": "VoxBox",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icons/icon.png"
    },
    "portable": {
      "artifactName": "VoxBox.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "tts_server.py",
      "tts_core.py",
      "requirements.txt",
      "package.json",
      "ui/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ]
  }
}
